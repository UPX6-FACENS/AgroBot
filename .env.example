# Copie para .env (gitignored) e preencha quando for trocar de canal.
# Sem preencher nada, CANAL_ATIVO=teste ja funciona sem conta nenhuma.

CANAL_ATIVO=teste

# Meta WhatsApp Cloud API — preencher quando a verificacao do Business
# Manager sair (ver docs/02-arquitetura.md secao 6)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Anthropic (redige a resposta final a partir do trecho recuperado da KB —
# ver pipeline/llm.py). Sem isso, o pipeline cai pro fallback mecanico.
ANTHROPIC_API_KEY=
